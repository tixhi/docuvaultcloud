# ============================================================================
# DocuVault (Java Spring Boot 3.3) — Environment Configuration
# ============================================================================

# --- Server & Profile -------------------------------------------------------
PORT=8080
# Set to 'local' for zero-setup in-memory H2 testing, or 'postgres' for production
SPRING_PROFILES_ACTIVE=postgres

# --- PostgreSQL (only used when SPRING_PROFILES_ACTIVE=postgres) ------------
DATABASE_URL=jdbc:postgresql://localhost:5432/docuvault
PGUSER=docuvault
PGPASSWORD=docuvault

# --- CORS -------------------------------------------------------------------
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5500,http://localhost:8080

# --- JWT Authentication (Min 32 characters for HMAC-SHA-256) ---------------
JWT_ACCESS_SECRET=docuvault-super-secure-production-ready-jwt-access-secret-key-32-chars
JWT_REFRESH_SECRET=docuvault-super-secure-production-ready-jwt-refresh-secret-key-32-chars

# --- Storage Configuration --------------------------------------------------
# Supported drivers: 'local' (writes to disk) or 's3' (AWS S3)
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_MB=250

# --- AWS S3 (only used when STORAGE_DRIVER=s3) ------------------------------
AWS_REGION=us-east-1
S3_BUCKET=your-docuvault-bucket
# Optional: AWS KMS key ID for SSE-KMS encryption (defaults to SSE-S3 AES256)
S3_KMS_KEY_ID=
S3_PRESIGNED_URL_TTL=300

# AWS Credentials (optional if running on EC2 instance profile or ECS/EKS IRSA)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Initial Seed Admin (Auto-seeded by DataInitializer on first boot) -------
ADMIN_EMAIL=admin@docuvault.local
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=System Administrator
