# ============================================================================
# DocuVault backend -- environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ============================================================================

# --- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# --- PostgreSQL -------------------------------------------------------------
# Provide either DATABASE_URL or the individual PG* fields.
DATABASE_URL=postgres://docuvault:docuvault@localhost:5432/docuvault
PGSSL=false

# --- JWT auth ---------------------------------------------------------------
JWT_ACCESS_SECRET=change-this-access-secret-in-production
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Storage (abstract -- local disk or S3, selected by STORAGE_DRIVER) ----
# "local" needs nothing further. "s3" needs the AWS_* / S3_* block below.
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_MB=250

# --- S3 (only used when STORAGE_DRIVER=s3) ----------------------------------
AWS_REGION=us-east-1
S3_BUCKET=your-docuvault-bucket
# Optional: enable SSE-KMS instead of the default SSE-S3 (AES256) encryption.
S3_KMS_KEY_ID=
# Optional: how long presigned upload/download URLs stay valid.
S3_PRESIGNED_URL_TTL=300

# --- IAM ---------------------------------------------------------------------
# Preferred: leave all three blank and let the app run under an IAM role
# (EC2 instance profile, ECS task role, or an EKS pod's IRSA role). The AWS
# SDK's default credential provider chain picks these up automatically.
#
# Cross-account or "assume a specific role" setups: set AWS_ROLE_ARN and the
# app will call sts:AssumeRole using whatever identity it's already running
# as. See backend/docs/aws-s3-iam-setup.md for the IAM policy + trust policy
# to attach.
AWS_ROLE_ARN=
AWS_ROLE_EXTERNAL_ID=
#
# Local development ONLY (never use long-lived keys in a real deployment):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Seed admin (used by db/seed.js) ----------------------------------------
ADMIN_EMAIL=admin@docuvault.local
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=System Administrator
